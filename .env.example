# 微信云开发环境ID
NEXT_PUBLIC_CLOUDBASE_ENV_ID=your-env-id

# SiliconFlow API Key
SILICONFLOW_API_KEY=your-api-key

# JWT密钥（用于登录认证）
JWT_SECRET=your-jwt-secret

# 微信开放平台配置（微信登录用）
# 1. 访问 https://open.weixin.qq.com/ 注册账号
# 2. 创建"网站应用"
# 3. 获取 AppID 和 AppSecret
# 4. 设置回调地址为：https://your-domain.com/api/auth/wechat/callback
WECHAT_APP_ID=your-wechat-appid
WECHAT_APP_SECRET=your-wechat-appsecret
WECHAT_REDIRECT_URI=https://your-domain.com/api/auth/wechat/callback
